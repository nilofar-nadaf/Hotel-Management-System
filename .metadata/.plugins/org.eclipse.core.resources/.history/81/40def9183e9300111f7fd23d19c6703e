        customerInfo = new JButton("Customer Info");
        customerInfo.setBounds(20, 200, 160, 30);
        customerInfo.setFont(btnFont);
        customerInfo.addActionListener(this);
        panel.add(customerInfo);

        // ================= MANAGER INFO =================

        managerInfo = new JButton("Manager Info");
        managerInfo.setBounds(20, 245, 160, 30);
        managerInfo.setFont(btnFont);
        managerInfo.addActionListener(this);
        panel.add(managerInfo);

        // ================= CHECKOUT =================

        checkout = new JButton("Checkout");
        checkout.setBounds(20, 290, 160, 30);
        checkout.setFont(btnFont);
        checkout.addActionListener(this);
        panel.add(checkout);

        // ================= UPDATE STATUS =================

//        updateStatus = new JButton("Update Status");
//        updateStatus.setBounds(20, 335, 160, 30);
