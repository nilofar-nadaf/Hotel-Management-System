        updateRoomStatus = new JButton("Update Room");
        updateRoomStatus.setBounds(20, 380, 160, 30);
        updateRoomStatus.setFont(btnFont);
        updateRoomStatus.addActionListener(this);
        panel.add(updateRoomStatus);

        // ================= PICKUP SERVICE =================

        pickupService = new JButton("Pickup Service");
        pickupService.setBounds(20, 425, 160, 30);
        pickupService.setFont(btnFont);
        pickupService.addActionListener(this);
        panel.add(pickupService);

        // ================= SEARCH ROOM =================

        searchRoom = new JButton("Search Room");
        searchRoom.setBounds(20, 470, 160, 30);
        searchRoom.setFont(btnFont);
        searchRoom.addActionListener(this);
        panel.add(searchRoom);

        // ================= LOGOUT =================

        logout = new JButton("Logout");
        logout.setBounds(20, 515, 160, 30);
        logout.setFont(btnFont);
        logout.addActionListener(this);
        panel.add(logout);

        // ================= SHOW WINDOW =================

