        panel.setBackground(Color.BLACK);
        image.add(panel);

        Font btnFont = new Font("Tahoma", Font.BOLD, 14);

        // ================= NEW CUSTOMER =================

        newCustomer = new JButton("New Customer");
        newCustomer.setBounds(20, 20, 160, 30);
        newCustomer.setFont(btnFont);
